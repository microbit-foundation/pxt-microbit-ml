{
  "name": "makecode-ml-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run i18n:compile && tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "i18n:compile": "microbit-i18n compile --config ../i18n.config.mjs",
    "predev": "npm run i18n:compile",
    "postinstall": "npm run i18n:compile",
    "i18n:tidy": "microbit-i18n tidy --config ../i18n.config.mjs",
    "i18n:download": "microbit-i18n download --config ../i18n.config.mjs",
    "i18n:upload": "microbit-i18n upload --config ../i18n.config.mjs",
    "i18n:status": "microbit-i18n status --config ../i18n.config.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.6.8"
  },
  "devDependencies": {
    "@microbit/eslint-config": "^0.2.1",
    "@microbit/i18n-tools": "^0.2.2",
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
